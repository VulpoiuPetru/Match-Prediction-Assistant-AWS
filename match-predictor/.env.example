# Copy to .env and fill in real values. Never commit the real .env file.

# Activates dev-only endpoints (TestController: /debug-config, /test-ai-detailed,
# /initialize-data, /test-ai, /status). Leave unset in any deployed environment.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/match_prediction_db
DB_USERNAME=postgres
DB_PASSWORD=

# Local LLM (used instead of Bedrock when running outside AWS — see OllamaConfig)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ChromaDB (vector store for RAG context)
CHROMADB_URL=http://localhost:8000

# Amazon Bedrock: no key/secret here. BedrockRuntimeClient uses the default AWS
# credential provider chain — an IAM role in ECS, or your local `aws configure`
# credentials / AWS_PROFILE when running outside Docker.
